{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-meta.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "hero:pack": "node scripts/pack-hero.mjs",
    "hero:video": "node scripts/pack-video.mjs",
    "scenes:pack": "node scripts/pack-scenes.mjs",
    "mobile:pack": "node scripts/pack-mobile.mjs",
    "cv:pdf": "node scripts/cv-pdf.mjs && node scripts/cv-pdf.mjs en"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "dompurify": "^3.4.15",
    "firebase": "^12.19.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
